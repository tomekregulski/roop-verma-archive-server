# Names only. Use separate local credentials; never copy deployed values.
DATABASE_URL=
HEROKU_POSTGRESQL_BROWN_URL=
API_KEY=
STRIPE_SECRET_KEY=
# Endpoint-specific signing secret; separate from the Stripe API key. Placeholder only.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_endpoint_signing_secret
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=
LOGIN_EMAIL_FROM=
# Fixed server-side support recipient; never accepted from browser input.
SUPPORT_EMAIL_TO=
AUTH_RATE_LIMIT_SECRET=
SESSION_COOKIE_SAME_SITE=lax
# Local loopback development only; production must use true.
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
PORT=8080

# Explicit server allowlist; no tier or mode is inferred from request input.
BILLING_PRICE_ID=
BILLING_PRODUCT_ID=
BILLING_CURRENCY=usd
BILLING_LIVEMODE=false

# Private playback only. Never use archive credentials or a public bucket.
# Absolute path to operator-owned JSON [{"trackId":1,"key":"playback/<sha256>.mp3"}].
PLAYBACK_ASSETS_FILE=
# Hosted startup wrapper only: durable private JSON materialized at PLAYBACK_ASSETS_FILE.
# Direct node index.js does not consume this value. Never put real manifest data in Git.
PLAYBACK_ASSETS_JSON=
PLAYBACK_R2_ACCOUNT_ID=
PLAYBACK_R2_BUCKET=
PLAYBACK_R2_JURISDICTION=default
PLAYBACK_R2_ACCESS_KEY_ID=
PLAYBACK_R2_SECRET_ACCESS_KEY=
