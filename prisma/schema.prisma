// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("HEROKU_POSTGRESQL_BROWN_URL")
}

model WebhookLog {
  id                  Int     @id @default(autoincrement())
  requestId           String
  idempotencyKey      String
  type                String
}

model User {
  id                  Int     @id @default(autoincrement())
  email               String  @unique
  firstName           String
  lastName            String
  subscription        Subscription[]
  billingCustomer     BillingCustomer?
  billingOperations   BillingOperation[]
  subscriptionActive  String?
  stripeId            String? @unique
  deletionRequestedAt DateTime?
  isAdmin             Boolean
  loginProofs         LoginProof[]
  identitySessions    IdentitySession[]
  checkoutOwnerships  CheckoutOwnership[]
}

model LoginProof {
  tokenHash  String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  expiresAt  DateTime
  delivered  Boolean  @default(false)
  consumedAt DateTime?
  @@index([expiresAt])
}

model IdentitySession {
  tokenHash String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  revokedAt DateTime?
  @@index([expiresAt])
}

model CheckoutOwnership {
  sessionId  String @id
  userId     Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
}

model IdentityRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

// TODO: subscription routes?
model Subscription {
  id                  String  @unique
  name                String
  user                User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId              Int?
  stripeId            String
  priceId             String
  productId           String
  status              String
  cancelAt            String?
  customer            BillingCustomer @relation(fields: [stripeId], references: [customerId])
  acceptedAt          DateTime?
  livemode            Boolean?
  cancelAtPeriodEnd   Boolean @default(false)
  canceledAt          DateTime?
  endedAt             DateTime?
  syncedAt            DateTime?
  syncIssueCode       String?
  grants              PaidInvoiceGrant[]
  @@index([stripeId, status])
}

// TODO: token routes?
model Token { 
  id                  Int       @id @default(autoincrement())
  createdAt           DateTime  @default(now())
  emailToken          String
  type                String
  expirationDate      DateTime
  userId              Int
  expiration          Int
}
model Track {
  id                  Int       @id @default(autoincrement())
  trackId             Int       @unique
  tape                Tape      @relation(fields: [tapeId], references: [id])
  tapeId              Int
  raga                Raga      @relation(fields: [ragaId], references: [id])
  ragaId              Int
  primaryArtist       Artist    @relation(fields: [primaryArtistId], references: [id])
  primaryArtistId     Int
  plays               Int?       @default(0)
  alap                Boolean
  jor                 Boolean
  jhalla              Boolean
  slowGat             Boolean
  mediumGat           Boolean
  fastGat             Boolean
  accompanied         Boolean
  notes               String?
  audioQuality        String?
  master              Boolean
  mediaType           MediaType @relation(fields: [mediaTypeId], references: [id])
  mediaTypeId         Int
  public              Boolean
  url                 String
}

model Artist {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  primaryTracks       Track[]
}

// TODO: category routes?
model Category {
  id                  Int       @id @default(autoincrement())
  name                String
  events              Event[]
}

model Event {
  id                  Int       @id @default(autoincrement())
  eventName           String
  date                String
  location            Location @relation(fields: [locationId], references: [id])
  locationId          Int
  category            Category @relation(fields: [categoryId], references: [id])
  categoryId          Int
  notes               String?
  tapes               Tape[]
}

model Location {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  events              Event[]
}

model MediaType {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  tracks              Track[]
}

model Raga {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  alternateSpelling   String?
  time                String?
  rasa                String?
  tracks              Track[]
}

model Tape {
  id                  Int       @id @default(autoincrement())
  tapeId              Int       @unique
  event               Event     @relation(fields: [eventId], references: [id])
  eventId             Int
  tracks              Track[]
}

model TrackArtist {
  id                  Int       @id @default(autoincrement())
  artistId            Int
  trackId             Int 
}

model TrackPlay {
  id                  Int       @id @default(autoincrement())
  userId              Int
  trackId             Int 
  secondsListened     Int
}

model Tribute {
  id                  Int       @id @default(autoincrement())
  submittedBy         String
  type                String
  content             String
}

model NetworkError {
  id                  Int     @id @default(autoincrement())
  errorCode           Int?
  errorMessage        String
  isRegisteredUser    Boolean
  userId              Int?
  userEmailAddress    String?
  timestamp           DateTime
  errorType           String?
}

// Durable ownership and revision lock. Keep this binding after User deletion.
model BillingCustomer {
  customerId          String @id
  userId              Int? @unique
  user                User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  livemode            Boolean?
  revision            Int @default(0)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  stripeDeletedAt     DateTime?
  lastSyncedAt        DateTime?
  syncIssueCode       String?
  reconcileCursor     String?
  lastFullScanAt      DateTime?
  // Isolated Stripe-led adapter; normal runtime does not select or read these yet.
  selectedSubscriptionId String? @unique
  selectedCanceledAt  DateTime?
  accessCheckedAt     DateTime?
  accessPolicyKey     String?
  cachedPaidFrom      DateTime?
  cachedPaidThrough   DateTime?
  accessFreshUntil    DateTime?
  subscriptions       Subscription[]
}

// One invoice pays one original period. Revocation never erases the evidence.
model PaidInvoiceGrant {
  invoiceId          String @id
  invoiceLineId      String @unique
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id])
  priceId            String
  serviceFrom        DateTime
  serviceThrough     DateTime
  settledAt          DateTime
  paymentIntentId    String @unique
  chargeId           String @unique
  currency           String
  amountPaid         Int
  invalidatedAt      DateTime?
  invalidationReason String?
  disputeId          String?
  reviewReason       String?
  verifiedAt         DateTime
  @@index([subscriptionId, serviceThrough])
}

// Routing/audit facts only. A pending receipt does not mean processing succeeded.
model StripeEventReceipt {
  eventId        String @id
  type           String
  objectId       String
  apiVersion     String?
  livemode       Boolean?
  eventCreatedAt DateTime?
  receivedAt     DateTime @default(now())
  outcome        String @default("pending")
  appliedAt      DateTime?
  attempts       Int @default(0)
  errorCode      String?
  lastAttemptAt  DateTime?
  @@index([outcome, receivedAt])
}

// Persist fixed registration/Checkout parameters before making a provider POST.
model BillingOperation {
  id          String @id
  activeKey   String? @unique
  kind        String
  userId      Int?
  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId  String?
  digest      String
  parameters  Json
  state       String @default("pending")
  externalId  String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}
